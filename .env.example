# App URL and Port Configuration
BASE_URL="http://localhost"
PORT=4000
NODE_ENV="production"
CORS_ORIGINS="*"

# Frontend API Connection URL (Used by Next.js Frontend)
NEXT_PUBLIC_BACKEND_URL="http://localhost:4000/api/v1"

# Replace with your actual live domain name:
# BASE_URL="https://engineersclinic.com"
# NEXT_PUBLIC_BACKEND_URL="https://engineersclinic.com/api/v1"


# Database Configuration Options
DATABASE_ADAPTER="mariadb"        # mariadb | mysql | pg
DATABASE_HOST="localhost"
DATABASE_PORT=3306
DATABASE_USER="your_db_user"
DATABASE_PASSWORD="your_db_password"
DATABASE_NAME="engineers_clinic"

# Prisma Database Connection URL
DATABASE_URL="mysql://your_db_user:your_db_password@localhost:3306/engineers_clinic"

# JWT Configuration
JWT_SECRET="change_me_strong_access_secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change_me_strong_refresh_secret"
JWT_REFRESH_EXPIRES_IN="30d"

# Razorpay Configuration (test keys)
RAZORPAY_KEY=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret