enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum CouponStatus {
  ACTIVE
  REDEEMED
  EXPIRED
  VOID
}


model PaymentGatewayConfig {
  id       Int     @id @default(autoincrement())
  code     String  @unique              // "razorpay", "stripe", "paypal" — matches the PaymentProvider registry key in app code
  name     String                       // display name, e.g. "Razorpay"
  isActive Boolean @default(true) @map("is_active")
  priority Int     @default(0)          // lower = preferred; used for fallback ordering when multiple gateways serve a country

  supportedCountries GatewayCountry[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("payment_gateway_configs")
}

model GatewayCountry {
  gatewayId Int @map("gateway_id")
  countryId Int @map("country_id")

  gateway PaymentGatewayConfig @relation(fields: [gatewayId], references: [id], onDelete: Cascade)
  country Country              @relation(fields: [countryId], references: [id])

  @@id([gatewayId, countryId])
  @@map("gateway_countries")
}


model Order {
  id        Int  @id @default(autoincrement())
  studentId Int  @map("student_id")
  programId Int  @map("program_id")
  couponId  Int? @map("coupon_id")

  amount   Decimal     @db.Decimal(10, 2)
  currency String
  status   OrderStatus @default(PENDING)

  gateway        String? // matches PaymentGatewayConfig.code; null until checkout gateway is chosen
  gatewayOrderId String? @unique @map("gateway_order_id") // gateway's own order/intent id
  receipt        String? @unique                           // our own idempotency reference, sent to the gateway as receipt/metadata

  student Student @relation(fields: [studentId], references: [userid])
  program Program @relation(fields: [programId], references: [id])
  coupon  Coupon? @relation(fields: [couponId], references: [id])

  payments   Payment[]
  enrollment Enrollment?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([studentId])
  @@index([programId, status])
  @@map("orders")
}

/// One row per settlement attempt. Multiple rows per Order is deliberate —
/// a failed attempt is retryable (doc §5.4: "a failed payment leaves the
/// order PENDING and is retryable"), and every attempt's failure reason
/// stays queryable instead of being overwritten by the next try.
/// This IS the "reconciliation record" the doc calls for.
model Payment {
  id      Int @id @default(autoincrement())
  orderId Int @map("order_id")

  gateway          String        // matches PaymentGatewayConfig.code
  gatewayPaymentId String        @unique @map("gateway_payment_id")
  status           PaymentStatus @default(CREATED)
  amount           Decimal       @db.Decimal(10, 2)
  currency         String
  method           String?       // card, upi, netbanking, wallet — generic label, gateway-agnostic
  fee              Decimal?      @db.Decimal(10, 2)
  tax              Decimal?      @db.Decimal(10, 2)

  errorCode        String? @map("error_code")
  errorDescription String? @db.Text @map("error_description")

  rawPayload Json? @map("raw_payload") // full gateway response, untouched — audit trail without schema coupling

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  gatewayCreatedAt DateTime? @map("gateway_created_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([orderId])
  @@map("payments")
}

// =============================================================================
// B2B — SEAT PURCHASE + COUPON DISTRIBUTION
// =============================================================================

/// College buys N seats on one program; invoice raised and paid (doc §5.4).
model SeatOrder {
  id             Int         @id @default(autoincrement())
  collegeId      Int         @map("college_id")
  programId      Int         @map("program_id")
  seatsPurchased Int         @map("seats_purchased")
  seatsRedeemed  Int         @default(0) @map("seats_redeemed") // reconciled on every coupon redemption
  amount         Decimal     @db.Decimal(10, 2)
  currency       String
  status         OrderStatus @default(PENDING)
  invoiceRef     String?     @map("invoice_ref")

  college College @relation(fields: [collegeId], references: [id])
  program Program @relation(fields: [programId], references: [id])

  couponBatch CouponBatch?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([collegeId])
  @@index([programId])
  @@map("seat_orders")
}

/// A batch of codes equal to the seat count (doc §5.4). collegeId/seatOrderId
/// nullable so this table also covers standalone marketing coupon batches
/// with no B2B purchase behind them.
model CouponBatch {
  id           Int    @id @default(autoincrement())
  collegeId    Int?   @map("college_id")
  seatOrderId  Int?   @unique @map("seat_order_id")
  programId    Int    @map("program_id")
  batchCode    String @unique @map("batch_code")
  totalCoupons Int    @map("total_coupons")

  college   College?   @relation(fields: [collegeId], references: [id])
  seatOrder SeatOrder? @relation(fields: [seatOrderId], references: [id])
  program   Program    @relation(fields: [programId], references: [id])

  coupons Coupon[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([collegeId])
  @@index([programId])
  @@map("coupon_batches")
}

/// Single-use, bound to the batch's program (doc §5.4: "a batch bought for
/// one programme cannot be spent on another"). Locked to REDEEMED inside
/// the same transaction that creates the Order, to prevent double-spend
/// under concurrency (doc §5.5).
model Coupon {
  id               Int          @id @default(autoincrement())
  batchId          Int          @map("batch_id")
  code             String       @unique
  status           CouponStatus @default(ACTIVE)
  redeemedByUserId Int?         @map("redeemed_by_user_id")
  redeemedAt       DateTime?    @map("redeemed_at")
  expiresAt        DateTime?    @map("expires_at")

  batch  CouponBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([batchId])
  @@map("coupons")
}
