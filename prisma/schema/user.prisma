// Prisma Schema for Engineers Clinic Backend (MySQL)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Country {
  id           Int     @id @default(autoincrement())
  isoCode      String  @unique @map("iso_code")
  name         String
  defaultLocal String  @map("default_local")
  timezone     String
  currencyCode String  @map("currency_code")
  isActive     Boolean @default(true) @map("is_active")

  users             User[]
  countriescolleges College[]
  programs          Program[]
  pricings          ProgramPricing[]

  gatewayCountries GatewayCountry[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("countries")
}

model User {
  id        Int    @id @default(autoincrement())
  email     String @unique
  password  String
  phoneNo   String @map("phone_no")
  roleId    Int    @map("role_id")
  countryId Int    @map("country_id")
  status    String @default("pending")

  // Relations
  role    Role    @relation(fields: [roleId], references: [id])
  country Country @relation(fields: [countryId], references: [id])

  student        Student?
  collegeMembers CollegeMember[]
  refreshTokens  RefreshToken[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([roleId])
  @@index([countryId])
  @@map("users")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique @db.VarChar(512)
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, isRevoked])
  @@map("refresh_tokens")
}

model Student {
  userid    Int    @id @map("user_id")
  firstName String @map("first_name")
  lastName  String @map("last_name")

  // Optional College relation (nullable)
  collegeId Int?     @map("college_id")
  college   College? @relation(fields: [collegeId], references: [id], onDelete: SetNull)

  // Custom / Unlisted College Name (When "Other" is selected)
  customCollegeName String? @map("custom_college_name")
  usn               String? @map("usn")
  branch            String? @map("branch")
  graduationYear    Int?    @map("graduation_year")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  enrollments  Enrollment[]
  submissions  Submission[]
  certificates Certificate[]
  orders       Order[]

  user User @relation(fields: [userid], references: [id], onDelete: Cascade)

  @@index([collegeId])
  @@map("students")
}

model College {
  id        Int    @id @default(autoincrement())
  name      String @unique
  address   String
  countryId Int    @map("country_id")
  status    String @default("pending")

  country  Country         @relation(fields: [countryId], references: [id])
  members  CollegeMember[]
  students Student[]

  seatOrders    SeatOrder[]
  couponBatches CouponBatch[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([countryId])
  @@map("colleges")
}

model CollegeMember {
  userId    Int @id @map("user_id")
  collegeId Int @map("college_id")

  user    User    @relation(fields: [userId], references: [id])
  college College @relation(fields: [collegeId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([collegeId])
  @@map("college_members")
}
