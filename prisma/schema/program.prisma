model Cluster {
  id          Int     @id @default(autoincrement())
  slug        String  @unique
  name        String
  description String? @db.Text

  topics Topic[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("clusters")
}


model Topic {
  id        Int     @id @default(autoincrement())
  clusterId Int     @map("cluster_id")
  slug      String  @unique
  name      String
  isActive  Boolean @default(true) @map("is_active")

  cluster Cluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  programs ProgramTopic[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("topics")
}


model ProgramTopic {
  programId Int @map("program_id")
  topicId   Int    @map("topic_id")

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  topic   Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([programId, topicId])
  @@map("program_topics")
}


model Program {
  id            Int     @id @default(autoincrement())
  countryId     Int     @map("country_id")
  title         String
  slug          String  @unique
  description   String? @db.Text
  durationHours Int     @map("duration_hours")
  status        String  @default("draft")
  outcomes      String? @db.Text

  country Country        @relation(fields: [countryId], references: [id])

  topics  ProgramTopic[]
  technologies ProgramTechnology[]
  pricings ProgramPricing[]
  projects Project[]
  enrollments Enrollment[]
  testimonials ProgramTestimonial[]
  faqs ProgramFaq[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("programs")
}

model Technology {
  id        Int  @id @default(autoincrement())
  slug      String  @unique
  name      String
  isActive  Boolean @default(true) @map("is_active")

  programs ProgramTechnology[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("technologies")
}

model ProgramTechnology {
  programId    Int @map("program_id")
  technologyId Int @map("technology_id")

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  technology Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([programId, technologyId])
  @@map("program_technologies")
}


model ProgramPricing {
  id          Int   @id @default(autoincrement())

  programId   Int   @map("program_id")
  countryId   Int   @map("country_id")

  currency    String
  amount      Decimal @db.Decimal(10, 2) // in rupees , dollar, euro

  isActive    Boolean  @default(true) @map("is_active")

  validFrom   DateTime? @map("valid_from")
  validUntil  DateTime? @map("valid_until")

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  country Country @relation(fields: [countryId],references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([programId, countryId])
  @@map("program_pricing")
}



model Project {
  id          Int     @id @default(autoincrement())
  programId   Int     @map("program_id")
  title       String
  description String? @db.Text
  orderIndex  Int     @map("order_index")

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  workspaceTemplate WorkspaceTemplate?
  resources         Resource[]
  enrollmentProjects EnrollmentProject[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([programId])
  @@map("projects")
}


model WorkspaceTemplate {
  id        Int     @id @default(autoincrement())
  projectId Int     @unique @map("project_id")
  version   Int     @default(1)
  isActive  Boolean @default(true) @map("is_active")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tasks TemplateTask[]
  studentWorkspaces StudentWorkspace[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("workspace_templates")
}

model TemplateTask {
  id                  Int     @id @default(autoincrement())
  workspaceTemplateId Int     @map("workspace_template_id")
  orderIndex          Int     @map("order_index")
  title               String
  description         String? @db.Text

  workspaceTemplate WorkspaceTemplate @relation(fields: [workspaceTemplateId], references: [id], onDelete: Cascade)

  rubric         Rubric?
  resources      Resource[]
  workspaceTasks WorkspaceTask[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceTemplateId])
  @@map("template_tasks")
}

model Rubric {
  id            Int    @id @default(autoincrement())
  taskId        Int    @unique @map("task_id")
  version       Int    @default(1)
  criteria      Json
  maxScore      Int    @default(100) @map("max_score")
  passThreshold Int    @default(60) @map("pass_threshold")

  task TemplateTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("rubrics")
}

enum ResourceOwnerType {
  PROJECT
  TASK
}

model Resource {
  id        Int               @id @default(autoincrement())
  ownerType ResourceOwnerType @map("owner_type")
  projectId Int?              @map("project_id")
  taskId    Int?              @map("task_id")
  type      String            @db.VarChar(20)
  title     String
  url       String

  project Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    TemplateTask? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([projectId])
  @@index([taskId])
  @@map("resources")
}

model ProgramTestimonial {
  id          Int     @id @default(autoincrement())
  programId   Int     @map("program_id")
  authorName  String  @map("author_name")
  authorRole  String? @map("author_role")   // e.g. "SDE at Infosys" or a college name
  quote       String  @db.Text
  rating      Int?    @db.SmallInt          // optional, 1-5
  avatarUrl   String? @map("avatar_url")
  orderIndex  Int     @default(0) @map("order_index")
  isActive    Boolean @default(true) @map("is_active")

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([programId])
  @@map("program_testimonials")
}

model ProgramFaq {
  id         Int     @id @default(autoincrement())
  programId  Int     @map("program_id")
  question   String
  answer     String  @db.Text
  orderIndex Int     @default(0) @map("order_index")
  isActive   Boolean @default(true) @map("is_active")

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([programId])
  @@map("program_faqs")
}

