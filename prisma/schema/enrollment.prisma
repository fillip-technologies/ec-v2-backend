enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  REVOKED
}

enum StepStatus {
  LOCKED
  OPEN
  PASSED
  NEEDS_WORK
  MANUAL_REVIEW
}

enum SubmissionStatus {
  EVALUATING
  PASSED
  NEEDS_WORK
}

model Enrollment {
  id        Int              @id @default(autoincrement())
  studentId Int              @map("student_id")
  programId Int              @map("program_id")
  status    EnrollmentStatus @default(ACTIVE)

  student Student @relation(fields: [studentId], references: [userid])
  program Program @relation(fields: [programId], references: [id])

  selectedProjects EnrollmentProject[]
  certificate      Certificate?
  
  orderId Int? @unique @map("order_id")
  order Order? @relation(fields: [orderId], references: [id])


  enrolledAt  DateTime  @default(now()) @map("enrolled_at")
  completedAt DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([programId, status])
  @@index([studentId])
  @@index([status])
  @@index([createdAt])
  @@map("enrollments")
}

enum EnrolledProjectStatus {
  LOCKED
  ACTIVE
  DONE
}

model EnrollmentProject {
  id           Int                   @id @default(autoincrement())
  enrollmentId Int                   @map("enrollment_id")
  projectId    Int                   @map("project_id")
  orderIndex   Int                   @map("order_index")
  status       EnrolledProjectStatus @default(LOCKED)

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  project    Project    @relation(fields: [projectId], references: [id])

  workspace StudentWorkspace?

  @@unique([enrollmentId, projectId])
  @@map("enrollment_projects")
}

model StudentWorkspace {
  id                   Int @id @default(autoincrement())
  enrollmentProjectId  Int @unique @map("enrollment_project_id")
  workspaceTemplateId  Int @map("workspace_template_id")
  templateVersion      Int @map("template_version")   // frozen at creation time
  repoUrl              String? @map("repo_url") @db.Text

  enrollmentProject EnrollmentProject @relation(fields: [enrollmentProjectId], references: [id], onDelete: Cascade)
  workspaceTemplate WorkspaceTemplate @relation(fields: [workspaceTemplateId], references: [id])

  tasks WorkspaceTask[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([workspaceTemplateId])
  @@map("student_workspaces")
}

model WorkspaceTask {
  id                 Int    @id @default(autoincrement())
  studentWorkspaceId Int    @map("student_workspace_id")
  templateTaskId     Int    @map("template_task_id")
  orderIndex         Int    @map("order_index")
  title              String
  description        String?  @db.Text

  studentWorkspace StudentWorkspace @relation(fields: [studentWorkspaceId], references: [id], onDelete: Cascade)
  templateTask     TemplateTask     @relation(fields: [templateTaskId], references: [id])

  progress    TaskProgress?
  submissions Submission[]

  @@index([studentWorkspaceId])
  @@index([templateTaskId])
  @@map("workspace_tasks")
}

model TaskProgress {
  id                Int        @id @default(autoincrement())
  workspaceTaskId   Int        @unique @map("workspace_task_id")
  status            StepStatus @default(LOCKED)
  resubmissionCount Int        @default(0) @map("resubmission_count")
  unlockedAt        DateTime?  @map("unlocked_at")
  passedAt          DateTime?  @map("passed_at")

  workspaceTask WorkspaceTask @relation(fields: [workspaceTaskId], references: [id], onDelete: Cascade)

  @@map("task_progress")
}

model Submission {
  id              Int              @id @default(autoincrement())
  workspaceTaskId Int              @map("workspace_task_id")
  studentId       Int              @map("student_id")
  commitHash      String?          @map("commit_hash") @db.VarChar(64)
  payloadUrl      String           @map("payload_url") @db.Text
  status          SubmissionStatus @default(EVALUATING)
  attemptIndex    Int              @default(1) @map("attempt_index")

  workspaceTask WorkspaceTask @relation(fields: [workspaceTaskId], references: [id], onDelete: Cascade)
  student       Student       @relation(fields: [studentId], references: [userid], onDelete: Cascade)

  aiReview AiReview?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([workspaceTaskId])
  @@index([studentId])
  @@index([status])
  @@index([createdAt])
  @@map("submissions")
}

model AiReview {
  id                Int        @id @default(autoincrement())
  submissionId      Int        @unique @map("submission_id")
  score             Int
  maxScore          Int        @default(100) @map("max_score")
  passed            Boolean    @default(false)
  criteriaBreakdown Json       @map("criteria_breakdown")
  feedback          String     @db.Text

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("ai_reviews")
}

model Certificate {
  id             Int        @id @default(autoincrement())
  enrollmentId   Int        @unique @map("enrollment_id")
  studentId      Int        @map("student_id")
  uuid           String     @unique
  certificateUrl String?    @map("certificate_url")
  issuedAt       DateTime   @default(now()) @map("issued_at")

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [userid], onDelete: Cascade)

  @@index([studentId])
  @@index([issuedAt])
  @@map("certificates")
}