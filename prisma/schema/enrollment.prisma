enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  REVOKED
}

enum StepStatus {
  LOCKED
  OPEN
  PASSED
  NEEDS_WORK
  MANUAL_REVIEW
}

model Enrollment {
  id        Int              @id @default(autoincrement())
  studentId Int              @map("student_id")
  programId Int              @map("program_id")
  status    EnrollmentStatus @default(ACTIVE)

  student Student @relation(fields: [studentId], references: [userid])
  program Program @relation(fields: [programId], references: [id])

  selectedProjects EnrollmentProject[]

  enrolledAt  DateTime  @default(now()) @map("enrolled_at")
  completedAt DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([programId, status])   // <- this is the index that makes counting fast
  @@index([studentId])
  @@map("enrollments")
}

model EnrollmentProject {
  id           Int @id @default(autoincrement())
  enrollmentId Int @map("enrollment_id")
  projectId    Int @map("project_id")
  orderIndex   Int @map("order_index")

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  project    Project    @relation(fields: [projectId], references: [id])

  workspace StudentWorkspace?

  @@unique([enrollmentId, projectId])
  @@map("enrollment_projects")
}

model StudentWorkspace {
  id                   Int @id @default(autoincrement())
  enrollmentProjectId  Int @unique @map("enrollment_project_id")
  workspaceTemplateId  Int @map("workspace_template_id")
  templateVersion      Int @map("template_version")   // frozen at creation time

  enrollmentProject EnrollmentProject @relation(fields: [enrollmentProjectId], references: [id], onDelete: Cascade)
  workspaceTemplate WorkspaceTemplate @relation(fields: [workspaceTemplateId], references: [id])

  steps WorkspaceStep[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("student_workspaces")
}

model WorkspaceStep {
  id                 Int    @id @default(autoincrement())
  studentWorkspaceId Int    @map("student_workspace_id")
  templateStepId     Int    @map("template_step_id")
  orderIndex         Int    @map("order_index")
  title              String   // copied, not referenced live
  description        String?  @db.Text

  studentWorkspace StudentWorkspace @relation(fields: [studentWorkspaceId], references: [id], onDelete: Cascade)
  templateStep     TemplateStep     @relation(fields: [templateStepId], references: [id])

  tasks    WorkspaceTask[]
  progress StepProgress?

  @@index([studentWorkspaceId])
  @@map("workspace_steps")
}


model WorkspaceTask {
  id              Int    @id @default(autoincrement())
  workspaceStepId Int    @map("workspace_step_id")
  templateTaskId  Int    @map("template_task_id")
  title           String
  description     String? @db.Text

  workspaceStep WorkspaceStep @relation(fields: [workspaceStepId], references: [id], onDelete: Cascade)
  templateTask  TemplateTask  @relation(fields: [templateTaskId], references: [id])

  @@index([workspaceStepId])
  @@map("workspace_tasks")
}

model StepProgress {
  id                Int        @id @default(autoincrement())
  workspaceStepId   Int        @unique @map("workspace_step_id")
  status            StepStatus @default(LOCKED)
  resubmissionCount Int        @default(0) @map("resubmission_count")
  unlockedAt        DateTime?  @map("unlocked_at")
  passedAt          DateTime?  @map("passed_at")

  workspaceStep WorkspaceStep @relation(fields: [workspaceStepId], references: [id], onDelete: Cascade)

  @@map("step_progress")
}